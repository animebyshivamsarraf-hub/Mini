# Mini AI — Environment Variables
# ⚠️ SIRF PLACEHOLDER. Asli keys yahan KABHI mat likho, git me KABHI commit mat karo.
# Keys server par set hoti hain:
#   Vercel: Dashboard → Project → Settings → Environment Variables
#   Cloudflare Worker: `npx wrangler secret put GEMINI_API_KEY`

# Gemini — https://aistudio.google.com (free, no card)
GEMINI_API_KEY=

# Groq — https://console.groq.com (free, no card)
GROQ_API_KEY=

# Supabase — https://supabase.com (free tier: 500MB DB, 50k users)
# Dashboard → New Project → Settings → API me URL + anon key milega
SUPABASE_URL=
SUPABASE_ANON_KEY=
